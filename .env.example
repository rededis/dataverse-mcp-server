# Azure AD tenant ID
DATAVERSE_TENANT_ID=your-tenant-id

# Azure app registration client ID
DATAVERSE_CLIENT_ID=your-client-id

# Azure app registration client secret
DATAVERSE_CLIENT_SECRET=your-client-secret

# Dataverse environment URL (e.g. https://your-org.crm.dynamics.com)
DATAVERSE_RESOURCE_URL=https://your-org.crm.dynamics.com

# Optional: filter entities by prefix (e.g. cr123_)
# DATAVERSE_ENTITY_PREFIX=

# Optional: default solution unique name to filter list_entities (e.g. MySolution)
# DATAVERSE_SOLUTION_NAME=

# Optional: enable delete operations (disabled by default for safety)
# DATAVERSE_ALLOW_DELETE=true

# Optional: timeout for each Dataverse request and for the token request, in
# milliseconds (default 30000, maximum 120000, which matches Dataverse's own 2-minute limit).
# Raise it for heavy schema changes such as create_entity with many columns
# DATAVERSE_REQUEST_TIMEOUT_MS=30000

# Optional: Dataverse service protection limits (HTTP 429). The server sends
# at most MAX_CONCURRENCY requests at once; up to MAX_QUEUE_LENGTH more wait
# for a free slot, for at most MAX_QUEUE_WAIT_MS. A throttled request is resent
# after the wait Dataverse asks for, MAX_ATTEMPTS sends in total, unless its
# waits would add up to more than MAX_RETRY_WAIT_MS. Both waits: maximum 120000.
# DATAVERSE_MAX_CONCURRENCY=8
# DATAVERSE_MAX_QUEUE_LENGTH=100
# DATAVERSE_MAX_QUEUE_WAIT_MS=30000
# DATAVERSE_MAX_ATTEMPTS=3
# DATAVERSE_MAX_RETRY_WAIT_MS=30000
