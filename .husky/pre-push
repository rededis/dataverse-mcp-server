#!/usr/bin/env sh
# Refuses a push whose commits add an environment host or a tenant or client
# ID (#167): the scan the ci job runs, before the commits reach GitHub, where
# they stay indexed. It reads the commits the remote does not have yet, by
# its remote-tracking branches; a commit already on any branch there is
# public and left to CI. The branches are the local copies: after the
# remote's URL is changed, or with a pushurl of its own, they describe
# another repository and hide commits from the scan until the next fetch.
# Not read, here or in CI: the message of an annotated tag, and a pushed ref
# that points at a tree or a blob instead of a commit.
# Betterleaks is not an npm package. Without it on PATH the push goes through
# with a warning, and CI stays the gate. CI pins the version (ci.yml); the
# hook runs whichever is installed.
if ! command -v betterleaks >/dev/null 2>&1; then
  echo "pre-push: betterleaks is not on PATH, so the environment host scan did not run; CI runs it after the push." >&2
  echo "pre-push: install it (brew install betterleaks, or the release binary) to have a finding stop the push." >&2
  exit 0
fi

remote=$1
pushed=
# One line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>.
# The local ref is what was typed and may hold spaces (HEAD@{1 hour ago}), so
# the sha is taken from the right: the last three fields have none.
while read -r line; do
  line=${line% *}
  line=${line% *}
  local_sha=${line##* }
  # All zeros: the push deletes the ref and adds no commits.
  case $local_sha in
    *[!0]*) pushed="$pushed $local_sha" ;;
  esac
done
[ -n "$pushed" ] || exit 0

# One scan for every ref of the push: a commit two of them share is read once.
# $pushed is split on purpose, one revision per sha.
# shellcheck disable=SC2086
if ! bash scripts/scan-commits.sh betterleaks $pushed --not "--remotes=$remote"; then
  echo "pre-push: the push is refused: the scan above found something, or could not run." >&2
  echo "pre-push: for a finding, rewrite the commits (git commit --amend, git rebase) and push again." >&2
  exit 1
fi
