        },
      },
      "type": "object",
    },
    "name": "get_picklist_options",
  },
  {
    "description": "Get a single record by ID from a Dataverse table",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entity_set": {
          "description": "Entity set name (plural, e.g. 'accounts', 'contacts')",
          "type": "string",
        },
        "expand": {
          "description": "Related entities to expand ($expand)",
          "type": "string",
        },
        "id": {
          "description": "Record GUID",
          "type": "string",
        },
        "select": {
          "description": "Comma-separated list of columns to return ($select)",
          "type": "string",
        },
      },
      "required": [
        "entity_set",
        "id",
      ],
      "type": "object",
    },
    "name": "get_record",
  },
  {
    "description": "Invoke a Dataverse Web API action (POST) — bound or unbound. Use for operations that are not plain CRUD, e.g. PublishDuplicateRule (bound to a duplicaterule) or QualifyLead (bound to a lead), or UnpublishDuplicateRule (unbound, takes DuplicateRuleId). Whether an action is bound is defined in the Web API $metadata. Pass entity_set+id for bound actions, neither for unbound. parameters becomes the JSON request body.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entity_set": {
          "description": "Entity set (plural, e.g. 'leads') for a bound action. Omit for unbound actions.",
          "type": "string",
        },
        "id": {
          "description": "Record GUID the bound action targets. Required iff entity_set is set.",
          "type": "string",
        },
        "name": {
          "description": "Action name, e.g. 'PublishDuplicateRule', 'QualifyLead'. Bare names are namespaced automatically for bound calls; pass a fully-qualified name to override.",
          "type": "string",
        },
        "parameters": {
          "additionalProperties": {},
          "description": "Action parameters sent as the JSON request body (e.g. { DuplicateRuleId } for PublishDuplicateRule, { CreateAccount, CreateContact, Status } for QualifyLead).",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "invoke_action",
  },
  {
    "description": "Invoke a Dataverse Web API function (GET) — bound or unbound. Use for read-only operations exposed as functions, e.g. WhoAmI (unbound) or RetrieveDuplicates. Pass entity_set+id for bound functions, neither for unbound. parameters are inlined into the URL as OData function arguments.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entity_set": {
          "description": "Entity set (plural) for a bound function. Omit for unbound functions.",
          "type": "string",
        },
        "id": {
          "description": "Record GUID the bound function targets. Required iff entity_set is set.",
          "type": "string",
        },
        "name": {
          "description": "Function name, e.g. 'WhoAmI'. Bare names are namespaced automatically for bound calls; pass a fully-qualified name to override.",
          "type": "string",
        },
        "parameters": {
          "additionalProperties": {},
          "description": "Function parameters, inlined as OData arguments. Strings are quoted, GUIDs/numbers/booleans passed as-is.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "invoke_function",
  },
  {
    "description": "List Dataverse tables (entities) with optional prefix and solution filters",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "prefix": {
          "description": "Filter entities by logical name prefix (e.g. 'contoso_'). Uses DATAVERSE_ENTITY_PREFIX env if not specified.",
          "type": "string",
        },
        "solution": {
          "description": "Filter entities by solution unique name (e.g. 'MySolution'). Uses DATAVERSE_SOLUTION_NAME env if not specified. Pass an empty string to disable the default filter.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "list_entities",
  },
  {
    "description": "List alternate keys defined on a Dataverse table. Returns a flat array of { logical_name, schema_name, display_name, key_attributes, entity_key_index_status, metadata_id }. entity_key_index_status reflects the background index build (Pending → Active, or Failed) — alt keys are not usable for keyed-PATCH upserts until Active.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entity_logical_name": {
          "description": "Logical name of the entity",
          "type": "string",
        },
      },
      "required": [
        "entity_logical_name",
      ],
      "type": "object",
    },
    "name": "list_entity_keys",
  },
  {
    "description": "List Dataverse solutions (uniquename is used to filter list_entities)",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "include_managed": {
          "description": "Include managed solutions (default: false — only unmanaged are returned)",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "list_solutions",
  },
  {
    "description": "Query records from a Dataverse table with OData filters",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "entity_set": {
          "description": "Entity set name (plural, e.g. 'accounts', 'contacts')",
          "type": "string",
        },
        "expand": {
          "description": "Related entities to expand ($expand)",
          "type": "string",
        },
        "filter": {
          "description": "OData filter expression ($filter)",
          "type": "string",
        },
        "orderby": {
          "description": "Order by expression ($orderby)",
          "type": "string",
        },
        "select": {
          "description": "Comma-separated list of columns to return ($select)",
          "type": "string",
        },
        "top": {
          "description": "Maximum number of records to return ($top)",
          "type": "number",
        },
      },
      "required": [
        "entity_set",
      ],
      "type": "object",
    },
    "name": "query_records",
  },
  {
    "description": "Update metadata of an existing column: display name, description, required level, max length, min/max value, precision. Dataverse fixes a column's type and logical name at creation — to change either, add_attribute a new column, migrate the values with update_record, then delete_attribute the old one.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attribute_logical_name": {
          "description": "Logical name of the column to update",
          "type": "string",
        },
        "date_behavior": {
          "description": "DateTime only: change storage semantics. ONE-WAY per Microsoft — you can switch from UserLocal to DateOnly or TimeZoneIndependent once, but cannot switch back or between the non-UserLocal values. Dataverse will return 400 if the behavior is already locked.",
          "enum": [
            "UserLocal",
            "DateOnly",
            "TimeZoneIndependent",
          ],
          "type": "string",
        },
        "date_format": {
          "description": "DateTime only: change UI presentation. See add_attribute for semantics.",
          "enum": [
            "DateOnly",
            "DateAndTime",
          ],
          "type": "string",
        },
        "description": {
          "description": "New description",
          "type": "string",
        },
        "display_name": {
          "description": "New display name",
          "type": "string",
        },
        "entity_logical_name": {
          "description": "Logical name of the entity",
          "type": "string",
        },
        "language_code": {
          "description": "Language code for labels (default: 1033)",
          "type": "number",
        },
        "max_length": {
          "description": "New max length (String/Memo only)",
          "type": "number",
        },
        "max_value": {
          "description": "New max value (numeric types only)",
          "type": "number",
        },
        "merge_labels": {
          "description": "If true, preserve existing localized labels in other languages; if false (default), replace all localized labels with just the new one.",
          "type": "boolean",
        },
        "min_value": {
          "description": "New min value (numeric types only)",
          "type": "number",
        },
        "precision": {
          "description": "New precision (Decimal/Money only)",
          "type": "number",
        },
        "required": {
          "description": "New required level",
          "enum": [
            "None",
            "ApplicationRequired",
            "SystemRequired",
          ],
          "type": "string",
        },
        "type": {
          "description": "Current type of the attribute (required to build the correct metadata discriminator; must match the existing type — type changes are not allowed)",
          "enum": [
            "String",
            "Integer",
            "BigInt",
            "Decimal",
            "Double",
            "Money",
            "DateTime",
            "Uniqueidentifier",
            "Memo",
            "Boolean",
            "Picklist",
          ],
          "type": "string",
        },
      },
      "required": [
        "entity_logical_name",
        "attribute_logical_name",
        "type",
      ],
      "type": "object",
    },
    "name": "update_attribute",
  },
  {
    "description": "Update an existing option's label/description on a Local or Global OptionSet (Dataverse UpdateOptionValue action). Requires Customizer or System Administrator role.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attribute_logical_name": {
          "description": "Picklist attribute logical name (Local OptionSet; pair with entity_logical_name). Mutually exclusive with option_set_name.",
          "type": "string",
        },
        "description": {
          "description": "New description",
          "type": "string",
        },
        "entity_logical_name": {
          "description": "Entity logical name (Local OptionSet; pair with attribute_logical_name). Mutually exclusive with option_set_name.",
          "type": "string",
        },
        "label": {
          "description": "New UI label",
          "type": "string",
        },
        "language_code": {
          "description": "Language code for the label (default: 1033)",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "merge_labels": {
          "description": "If true, merge the new label with existing localized labels (other languages kept); if false (default), replace all localized labels with just the new one.",
          "type": "boolean",
        },
        "option_set_name": {
          "description": "Global OptionSet name. Mutually exclusive with entity_logical_name/attribute_logical_name.",
          "type": "string",
        },
        "solution_unique_name": {
          "description": "Solution unique name (defaults to the Default Solution)",
          "type": "string",
        },
        "value": {
          "description": "Numeric value of the option to update",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "value",
        "label",
      ],
      "type": "object",
    },
    "name": "update_picklist_option",
  },
  {
    "description": "Update an existing record in a Dataverse table",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "data": {
          "additionalProperties": {},
          "description": "Fields to update as key-value pairs",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "entity_set": {
          "description": "Entity set name (plural, e.g. 'accounts', 'contacts')",
          "type": "string",
        },
        "id": {
          "description": "Record GUID",
          "type": "string",
        },
      },
      "required": [
        "entity_set",
        "id",
        "data",
      ],
      "type": "object",
    },
    "name": "update_record",
  },
]
`;
