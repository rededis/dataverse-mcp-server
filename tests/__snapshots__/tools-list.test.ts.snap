              "display_name",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "description": {
          "description": "Table description",
          "type": "string",
        },
        "display_collection_name": {
          "description": "Plural display name",
          "type": "string",
        },
        "display_name": {
          "description": "Display name",
          "type": "string",
        },
        "logical_name": {
          "description": "Logical name with publisher prefix (e.g. 'contoso_newtable')",
          "type": "string",
        },
        "ownership_type": {
          "description": "Ownership type (default: UserOwned)",
          "enum": [
            "UserOwned",
            "OrganizationOwned",
          ],
          "type": "string",
        },
        "primary_attribute_display_name": {
          "description": "Display name for primary name attribute (default: 'Name')",
          "type": "string",
        },
        "primary_attribute_name": {
          "description": "Logical name for primary name attribute (default: '{prefix}_name')",
          "type": "string",
        },
      },
      "required": [
