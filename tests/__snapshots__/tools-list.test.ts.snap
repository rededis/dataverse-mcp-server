            "type": "string",
          },
          "type": "object",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "invoke_function",
  },
  {
    "description": "List Dataverse tables (entities) with optional prefix and solution filters",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
