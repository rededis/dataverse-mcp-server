              "min_value": {
                "description": "Min value for numeric types",
                "type": "number",
              },
              "options": {
                "description": "Options for Boolean (2 items: false=0, true=1) or Picklist types. Creates a Local OptionSet owned by this one column; mutually exclusive with global_option_set.",
                "items": {
                  "properties": {
