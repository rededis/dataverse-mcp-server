// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`tools/list > matches the snapshot with deletes disabled 1`] = `
[
  {
    "description": "Add a column (attribute) to an existing Dataverse table",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attribute": {
          "properties": {
            "date_behavior": {
              "description": "DateTime only: storage/projection semantics. 'UserLocal' (default) shifts by viewer's TZ; 'DateOnly' stores a calendar date (requires date_format=DateOnly); 'TimeZoneIndependent' stores wall-clock time identical across TZs. Per Microsoft docs, changing DateTimeBehavior on an existing column is a one-way operation (UserLocal → other) and cannot be reverted.",
              "enum": [
                "UserLocal",
                "DateOnly",
                "TimeZoneIndependent",
              ],
              "type": "string",
            },
            "date_format": {
              "description": "DateTime only: UI presentation — 'DateOnly' hides the time picker (calendar columns), 'DateAndTime' shows both (default).",
              "enum": [
                "DateOnly",
                "DateAndTime",
              ],
              "type": "string",
            },
            "description": {
              "description": "Description",
              "type": "string",
            },
            "display_name": {
              "description": "Display name",
              "type": "string",
            },
            "global_option_set": {
              "description": "Picklist only: bind the column to an existing Global OptionSet by its set name (e.g. 'contoso_sourceset') so the column shares one org-wide list instead of a private copy. Mutually exclusive with options.",
              "minLength": 1,
              "type": "string",
            },
            "logical_name": {
              "description": "Logical name (e.g. 'contoso_amount')",
              "type": "string",
            },
            "max_length": {
              "description": "Max length for String/Memo",
              "type": "number",
            },
            "max_value": {
              "description": "Max value for numeric types",
              "type": "number",
            },
            "min_value": {
              "description": "Min value for numeric types",
              "type": "number",
            },
            "options": {
              "description": "Options for Boolean (2 items: false=0, true=1) or Picklist types. Creates a Local OptionSet owned by this one column; mutually exclusive with global_option_set.",
              "items": {
                "properties": {
                  "label": {
                    "type": "string",
                  },
                  "value": {
                    "type": "number",
                  },
                },
                "required": [
                  "label",
                  "value",
                ],
                "type": "object",
              },
              "type": "array",
            },
            "precision": {
              "description": "Decimal precision for Decimal/Money",
              "type": "number",
            },
            "required": {
              "description": "Required level (default: None)",
              "enum": [
                "None",
                "ApplicationRequired",
                "SystemRequired",
              ],
              "type": "string",
            },
            "type": {
              "description": "Attribute type",
              "enum": [
                "String",
                "Integer",
                "BigInt",
                "Decimal",
                "Double",
                "Money",
                "DateTime",
                "Uniqueidentifier",
                "Memo",
                "Boolean",
                "Picklist",
              ],
              "type": "string",
            },
          },
          "required": [
            "logical_name",
            "type",
            "display_name",
          ],
          "type": "object",
        },
        "entity_logical_name": {
          "description": "Logical name of the entity",
          "type": "string",
        },
      },
      "required": [
        "entity_logical_name",
        "attribute",
      ],
      "type": "object",
    },
    "name": "add_attribute",
  },
  {
    "description": "Create an alternate key on a Dataverse table (composite supported via key_attributes). Use for race-safe upserts via keyed-PATCH or to enforce a uniqueness constraint that the primary key doesn't cover. NOTE: Dataverse builds the supporting unique index asynchronously — the key is not usable for keyed lookups until its EntityKeyIndexStatus becomes 'Active'. Poll with list_entity_keys.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "display_name": {
          "description": "Display name for the key",
          "type": "string",
        },
        "entity_logical_name": {
          "description": "Logical name of the entity",
          "type": "string",
        },
        "key_attributes": {
          "description": "Logical names of attributes that compose the key (one for a single-column key, multiple for a composite key). Lookups and supported primitive types only — Dataverse rejects keys over Memo, image, or file columns.",
          "items": {
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "logical_name": {
          "description": "Logical name of the new key with publisher prefix (e.g. 'contoso_contactproviderkey')",
          "type": "string",
        },
        "solution_unique_name": {
          "description": "Solution unique name (defaults to the Default Solution)",
          "type": "string",
        },
      },
      "required": [
        "entity_logical_name",
        "logical_name",
        "display_name",
        "key_attributes",
      ],
      "type": "object",
    },
    "name": "add_entity_key",
  },
  {
    "description": "Add an option to an existing Local or Global OptionSet (Dataverse InsertOptionValue action). Requires Customizer or System Administrator role; HTTP 403 otherwise.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "attribute_logical_name": {
          "description": "Picklist attribute logical name (Local OptionSet; pair with entity_logical_name). Mutually exclusive with option_set_name.",
          "type": "string",
        },
        "description": {
          "description": "Optional description",
          "type": "string",
        },
        "entity_logical_name": {
          "description": "Entity logical name (Local OptionSet; pair with attribute_logical_name). Mutually exclusive with option_set_name.",
          "type": "string",
        },
        "label": {
          "description": "UI label for the new option (e.g. 'Queued')",
          "type": "string",
        },
        "language_code": {
          "description": "Language code for the label (default: 1033 = English)",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
        "option_set_name": {
          "description": "Global OptionSet name. Mutually exclusive with entity_logical_name/attribute_logical_name.",
          "type": "string",
        },
        "solution_unique_name": {
          "description": "Solution unique name (defaults to the Default Solution)",
          "type": "string",
        },
        "value": {
          "description": "Explicit option value. Must fall within the publisher's customization prefix range (e.g. 909890XXX). If omitted, Dataverse assigns the next free value.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer",
        },
      },
      "required": [
        "label",
      ],
      "type": "object",
    },
    "name": "add_picklist_option",
  },
  {
